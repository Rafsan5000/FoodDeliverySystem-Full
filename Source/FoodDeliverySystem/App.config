<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!-- ======================================================================
       PROTECTED FILE - do not edit without telling the team.
       Change ONLY the "Data Source" value to your own SQL Server name.
       Find it in SSMS: the "Server name" box on the Connect dialog.
       Examples:  ASUS  |  DESKTOP-1234\SQLEXPRESS  |  (localdb)\MSSQLLocalDB
       ====================================================================== -->
  <connectionStrings>
    <add name="RestaurantDB"
         connectionString="Data Source=ASUS;Initial Catalog=RestaurantDB;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
